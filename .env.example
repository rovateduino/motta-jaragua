# ---------------------------------------------------------------------------
# Mercado Motta Jaraguá — variáveis de ambiente (nomes apenas, sem valores reais)
# Copie para .env e preencha localmente. NUNCA comite o .env.
# ---------------------------------------------------------------------------

# Modo da aplicação: "demo" (dados fictícios, nenhuma cobrança real) ou "production".
APP_MODE=demo

# Banco de dados PostgreSQL gerenciado (Neon).
# DATABASE_URL: conexão POOLED, usada pela aplicação em runtime.
# DIRECT_URL: conexão DIRETA, usada pelo Prisma para migrations e introspecção.
# No Neon, mantenha sslmode=require nas duas strings. Na pooled, inclua
# pgbouncer=true. Nunca comite valores reais.
DATABASE_URL="postgresql://USER:PASSWORD@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Aplicação
NEXT_PUBLIC_APP_NAME="Mercado Motta Jaraguá"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Integrações — habilitadas somente na Fase 5, com credenciais reais.
# Pagamento
PAYMENT_PROVIDER=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# WhatsApp
WHATSAPP_PROVIDER=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# E-mail transacional
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""

# Fiscal (NFC-e)
FISCAL_PROVIDER=""
FISCAL_API_KEY=""

# ERP / POS
ERP_PROVIDER=""
ERP_API_KEY=""

# Supabase Storage (bucket público "product-images")
SUPABASE_URL="https://[seu-projeto].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-secreta-aqui"
